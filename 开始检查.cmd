@echo off
setlocal EnableExtensions DisableDelayedExpansion
REM Windows 360 Cleaner v1.0.0 launcher. Double-click it after extracting the whole ZIP.
REM It opens the guided window. Scanning and verifying only read information. Nothing is
REM removed unless you tick items in the window and confirm; this file never starts a removal.
REM Start-Check.cmd and the Chinese-named launcher in the package root are identical copies.
if not exist "%~dp0scripts\Select-360Cleanup.ps1" goto missing
if not exist "%~dp0scripts\Invoke-360Cleanup.ps1" goto missing
if not exist "%~dp0scripts\Windows360Cleaner.Library.ps1" goto missing
powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "%~dp0scripts\Select-360Cleanup.ps1"
set "W360_RESULT=%ERRORLEVEL%"
if "%W360_RESULT%"=="0" exit /b 0
REM Exit code 20 means the window already showed its own error message.
if "%W360_RESULT%"=="20" exit /b 20
goto failed

:missing
REM Test hook (tests\Test-Packaging.ps1 only): if WINDOWS_360_CLEANER_LAUNCHER_TEST is defined, print a
REM marker and exit 1 instead of showing the message box, so automated tests never wait for a click.
if defined WINDOWS_360_CLEANER_LAUNCHER_TEST goto missing_test
echo Windows 360 Cleaner: the program files in the scripts folder were not found.
echo Extract the whole downloaded ZIP first, then run Start-Check from the extracted folder.
REM The encoded command (Base64 of a UTF-16LE script) only shows this message in Chinese and English.
powershell.exe -NoProfile -EncodedCommand 
exit /b 1

:missing_test
echo W360-LAUNCHER-TEST: MissingProgramFiles
exit /b 1

:failed
REM PowerShell could not run the window (for example blocked by policy) or it stopped unexpectedly.
if defined WINDOWS_360_CLEANER_LAUNCHER_TEST goto failed_test
echo Windows 360 Cleaner could not run or stopped unexpectedly. Run scripts\Scan-360.cmd to see the error.
powershell.exe -NoProfile -EncodedCommand 
exit /b %W360_RESULT%

:failed_test
echo W360-LAUNCHER-TEST: SelectorFailed %W360_RESULT%
exit /b %W360_RESULT%
